// vim: set ft=jsonc :

// `cat opencode.jsonc.template | tail -n +4 | jq --arg key "$(pass sakura.ad.jp/llm_token)" '.providers.sakura.settings.apiKey = $key' > opencode.jsonc`

{
	"$schema": "https://opencode.ai/config.json",
	"providers": {
		"sakura": {
			"name": "Sakura AI Engine",
			"package": "@opencode/ai/providers/openai-compatible",
			"settings": {
				"baseURL": "https://api.ai.sakura.ad.jp/v1",
				"apiKey": "REPLACE_WITH_JQ"
			},
			"models": {
				"kimi-k27-code": {
					"name": "Kimi K2.7 Code",
					"modelID": "preview/Kimi-K2.7-Code",
					"capabilities": {
						"tools": true,
						"input": ["text", "image"],
						"output": ["text"]
					},
					"limit": {
						"context": 262144,
						"output": 32000
					}
				},
				"glm-53-flash": {
					"name": "GLM-5.3 Flash",
					"modelID": "preview/GLM-5.3-Flash",
					"capabilities": {
						"tools": true,
						"input": ["text", "image"],
						"output": ["text"]
					},
					"limit": {
						"context": 1048575,
						"output": 32000
					}
				}
			}
		}
	}
}
