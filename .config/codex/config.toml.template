# `cat config.toml.template | envsubst > config.toml`

approval_policy = 'on-request'
approvals_reviewer = 'auto_review'
default_permissions = 'kjuq'

# `ssh-keygen -t ed25519 -C "44694396+kjuq@users.noreply.github.com" -f ~/.ssh/id_ed25519_sign -P ''`
# `gh ssh-key add ~/.ssh/id_ed25519_sign.pub --type signing --title 'CodingAgent'`
[shell_environment_policy.set]
GIT_CONFIG_COUNT = '1'
GIT_CONFIG_KEY_0 = 'user.signingKey'
GIT_CONFIG_VALUE_0 = '~/.ssh/id_ed25519_sign'

[permissions.kjuq]
extends = ':workspace'

[permissions.kjuq.filesystem]
glob_scan_max_depth = 8
'$PASSWORD_STORE_DIR' = 'deny'
'$XDG_CONFIG_HOME/gnupg' = 'deny'
'$XDG_RUNTIME_DIR/gnupg' = 'deny'

[permissions.kjuq.filesystem.':workspace_roots']
'.git' = 'write'
'.git/config' = 'read'
'.git/hooks' = 'read'
'.git/info' = 'read'
'.git/modules' = 'read'
'.git/worktrees' = 'read'
'*.env' = 'deny'
'**/.env' = 'deny'
'**/*.env' = 'deny'
'*.pem' = 'deny'
'**/.pem' = 'deny'
'**/*.pem' = 'deny'

[permissions.kjuq.network]
enabled = true
allow_upstream_proxy = false

[permissions.kjuq.network.domains]
"*" = "allow"
"161.33.178.151" = "deny" # OCI instance IPv4
"2603:c021:8018:a0aa::a" = "deny" # OCI instance IPv6

[features]
remote_control = true
network_proxy = true
hooks = true

[mcp_servers.herdr]
command = '$CODEX_HOME/kjuq/mcp/herdr_mcp.py'
env_vars = [ "HERDR_ENV", "HERDR_PANE_ID", "HERDR_SOCKET_PATH", "HERDR_SESSION", ]
enabled_tools = [ "list_agents", "get_agent", "prompt_agent", "wait_agent", "list_panes", "start_codex", "read_codex", "quit_codex", ]
startup_timeout_sec = 60
tool_timeout_sec = 130

# vim: set ft=toml:
